{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semasvg.org/schema/project-0.1.json",
  "title": "SemaSVG project manifest",
  "type": "object",
  "required": [
    "semasvg",
    "project",
    "profiles",
    "views"
  ],
  "properties": {
    "semasvg": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
